    "Sandbox Destroy": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "WORKSPACE": "workspace.json",
        "ENVIRONMENT": "prod",
