      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "WORKSPACE": "workspace.json",
        "ENVIRONMENT": "prod",
        "DEPLOYMENT": "sandbox",
        "ENV": "prod",
        "PULUMI_COMMAND": "preview"
      }
